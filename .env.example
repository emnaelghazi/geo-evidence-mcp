# Copy with `make init` (fills every CHANGEME with a random secret). Never commit .env.
LOG_LEVEL=INFO

# --- LLM (set your own key in .env; leave empty here) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- PostGIS + pgvector ---
POSTGRES_USER=gem
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=gem
DB_HOST=localhost
DB_PORT=5432

# --- Provenance storage: memory | postgres (use postgres after `make up`) ---
STORE_BACKEND=memory

# --- STAC ---
STAC_ENDPOINT=https://earth-search.aws.element84.com/v1

# --- Langfuse client (the app) ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=CHANGEME
LANGFUSE_SECRET_KEY=CHANGEME

# --- Langfuse server (docker-compose.langfuse.yml) ---
LANGFUSE_IMAGE_TAG=4
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGEME
SALT=CHANGEME
ENCRYPTION_KEY=CHANGEME
LANGFUSE_DB_PASSWORD=CHANGEME
CLICKHOUSE_PASSWORD=CHANGEME
MINIO_ROOT_PASSWORD=CHANGEME
REDIS_AUTH=CHANGEME
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=CHANGEME
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=CHANGEME
