diff --git a/docker/postgis-pgvector/Dockerfile b/docker/postgis-pgvector/Dockerfile
index 3751d4b..cac8f97 100644
--- a/docker/postgis-pgvector/Dockerfile
+++ b/docker/postgis-pgvector/Dockerfile
@@ -1,13 +1,17 @@
-# PostgreSQL 16 + PostGIS 3.4 (upstream image) + pgvector built from a pinned tag.
-# TODO(M0 verify): confirm the base tag exists for your CPU arch (Apple Silicon may need
-# `platform: linux/amd64` in docker-compose.yml).
-FROM postgis/postgis:16-3.4
+# PostgreSQL 16 on Debian bookworm, PostGIS from the PGDG repository (already configured in the
+# official image), and pgvector built from a pinned tag.
+#
+# History: the first version used postgis/postgis:16-3.4, which is Debian bullseye. The PGDG apt
+# repository for bullseye was removed (404 on apt.postgresql.org), so `apt-get update` failed in CI.
+FROM postgres:16-bookworm
 
 ARG PGVECTOR_VERSION=v0.7.4
 # OPTFLAGS="" drops -march=native, so the image also runs on a different CPU than the build host.
 
 RUN apt-get update \
- && apt-get install -y --no-install-recommends build-essential git ca-certificates postgresql-server-dev-16 \
+ && apt-get install -y --no-install-recommends \
+      postgresql-16-postgis-3 postgresql-16-postgis-3-scripts \
+      build-essential git ca-certificates postgresql-server-dev-16 \
  && git clone --branch "${PGVECTOR_VERSION}" --depth 1 https://github.com/pgvector/pgvector.git /tmp/pgvector \
  && cd /tmp/pgvector && make OPTFLAGS="" && make OPTFLAGS="" install \
  && apt-get purge -y --auto-remove build-essential git postgresql-server-dev-16 \
diff --git a/docs/adr/ADR-001-stack-and-scope.md b/docs/adr/ADR-001-stack-and-scope.md
index b711805..e1111ff 100644
--- a/docs/adr/ADR-001-stack-and-scope.md
+++ b/docs/adr/ADR-001-stack-and-scope.md
@@ -14,7 +14,11 @@ a naive one (see the project brief, requirements R1-R17).
 - Python 3.12+ (deviation from the brief's 3.11+: `rasterio==1.5.2` requires >=3.12, verified by
   dependency resolution on 2026-11-11), `uv` for environments and lockfile, `ruff` + `mypy --strict` + `pre-commit`.
 - All dependencies pinned exactly in `pyproject.toml`, added in the milestone that first uses them.
-- PostgreSQL 16 + PostGIS 3.4 + pgvector built from tag `v0.7.4` (one image, `docker/postgis-pgvector`).
+- PostgreSQL 16 + PostGIS 3.x + pgvector built from tag `v0.7.4` (one image, `docker/postgis-pgvector`).
+  The image is built from `postgres:16-bookworm` with PostGIS from PGDG: the original base
+  `postgis/postgis:16-3.4` is Debian bullseye, whose PGDG repository was removed, which broke the
+  CI build on 2026-11-15. PostGIS therefore follows what PGDG ships for PostgreSQL 16 (3.4 in the
+  development environment); CI asserts 3.x, not a minor version.
 - Langfuse self-hosted from a trimmed copy of the upstream compose file (v4 image line).
 - Config only through environment variables (`pydantic-settings`); `make init` generates all secrets
   into an untracked `.env`.
